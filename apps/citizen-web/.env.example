# Citizen Website Environment Configuration
# Copy to .env.local for local development. NEVER put private secrets in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Production (Vercel): NEXT_PUBLIC_API_BASE_URL=/api and API_PROXY_TARGET=<API origin>,
# e.g. https://smart-light-api.onrender.com. The site then forwards /api/* to the API
# so login cookies stay first-party. Leave API_PROXY_TARGET empty locally.
API_PROXY_TARGET=
NEXT_PUBLIC_APP_NAME=Citizen Street Light Portal

# Municipality served by this deployment (one portal per city)
NEXT_PUBLIC_TENANT_SLUG=indore-mc
