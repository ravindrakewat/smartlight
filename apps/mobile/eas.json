{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smart-light-api.onrender.com/api",
        "EXPO_PUBLIC_APP_NAME": "Smart Light Field"
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://smart-light-api.onrender.com/api",
        "EXPO_PUBLIC_APP_NAME": "Smart Light Field"
      }
    }
  }
}
