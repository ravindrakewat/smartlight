# Mobile Application (Expo) Environment Configuration
# Copy to .env for local development. NEVER put private secrets in EXPO_PUBLIC_* variables.

# "localhost" only works on the iOS simulator. Use:
#   Android emulator:   http://10.0.2.2:4000/api
#   Physical phone:     http://<your-computer-LAN-IP>:4000/api  (same Wi-Fi)
#   Production:         https://api.<your-domain>/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
EXPO_PUBLIC_APP_NAME=Smart Light Field
