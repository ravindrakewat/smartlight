{
  "name": "@smart-light/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Field technician app (React Native + Expo) for Smart Street Light Management System",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@smart-light/shared": "*",
    "@tanstack/react-query": "^5.108.2",
    "expo": "~53.0.0",
    "expo-camera": "~16.1.11",
    "expo-constants": "~17.1.8",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "query-string": "^7.1.3",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@smart-light/config": "*",
    "@types/react": "^19.0.10",
    "typescript": "^5.8.3"
  }
}
