{
  "name": "@smart-light/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Field technician app (React Native + Expo) for Smart Street Light Management System",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "eas-build-post-install": "cd ../.. && npm run build -w @smart-light/shared"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@smart-light/shared": "*",
    "@tanstack/react-query": "^5.108.2",
    "expo": "58.0.23",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.15",
    "expo-linking": "58.0.16",
    "expo-location": "58.0.20",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "query-string": "^7.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@smart-light/config": "*",
    "@types/react": "^19.0.10",
    "typescript": "^5.8.3"
  }
}
