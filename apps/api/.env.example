# Central Backend API Environment Configuration
# Copy to .env for local development. NEVER commit .env files or real secrets.

NODE_ENV=development
PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=smart-light-api
APP_VERSION=0.1.0

# Comma-separated allowed web origins (citizen-web, municipal-admin, super-admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Number of reverse proxies in front of the API (0 locally, 1 on Render).
# Required for correct client IPs (rate limiting, audit logs).
TRUST_PROXY_HOPS=0
