# Central Backend API Environment Configuration
# Copy to .env for local development. NEVER commit .env files or real secrets.

NODE_ENV=development
PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
SERVICE_NAME=smart-light-api
APP_VERSION=0.1.0

# Comma-separated allowed web origins (citizen-web, municipal-admin, super-admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Number of reverse proxies in front of the API (0 locally, 1 on Render).
# Required for correct client IPs (rate limiting, audit logs).
TRUST_PROXY_HOPS=0

# PostgreSQL. Local: `npm run db:dev` then use the URL below.
# Render: use the INTERNAL database URL.
DATABASE_URL=postgresql://smart_light:smart_light_dev@localhost:5433/smart_light_dev
DATABASE_POOL_MAX=10

# Access-token signing key, at least 32 characters. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Two-factor sign-in. 32-byte key (base64) that encrypts the authenticator secrets:
# openssl rand -base64 32 . Required in production; empty locally = derived from
# JWT_ACCESS_SECRET. Never change it once admins have enrolled (they would have to re-enrol).
MFA_ENCRYPTION_KEY=
# Roles that must use two-factor sign-in (SUPER_ADMIN and/or MUNICIPAL_ADMIN).
MFA_REQUIRED_ROLES=SUPER_ADMIN

# Production: parent domain shared by API and consoles, e.g. .smartlight.example.in
COOKIE_DOMAIN=
# Defaults to true in production; keep false for http://localhost
COOKIE_SECURE=false

# Swagger UI at /api/docs (defaults to on outside production)
API_DOCS_ENABLED=true

# SMS. `console` prints messages to the log (local). `msg91` sends real SMS using
# DLT-approved templates; each MSG91 Flow template uses ##var1## for its value.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_OTP=
MSG91_TEMPLATE_COMPLAINT_RESOLVED=

# QA / app-store review only: numbers that get a fixed OTP and no SMS, e.g.
# +919000000001:246810. Leave empty for real citizens.
OTP_TEST_NUMBERS=

# IoT worker only (npm run dev:worker): MQTT broker the controllers connect to.
# Production: mqtts://<broker-host>:8883 with a backend-only username/password whose
# ACL allows sl/v1/# . Locally any broker works, e.g. mqtt://localhost:1883.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=sl-backend-worker
