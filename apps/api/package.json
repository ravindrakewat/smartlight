    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@smart-light/config": "*",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
