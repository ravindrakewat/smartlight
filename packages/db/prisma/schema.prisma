// Smart Street Light Management System — PostgreSQL schema
//
// Conventions
// - Every tenant-owned row carries `tenantId`; every query on it MUST filter by tenant.
// - Primary keys are UUIDv7 (time-ordered → good index locality).
// - Timestamps are `timestamptz` with millisecond precision.
// - Human-facing reference numbers (pole codes, complaint and work-order numbers)
//   are generated from per-tenant counters (see `TenantCounter`).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

enum TenantStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

/// A municipal corporation using the platform (e.g. Indore, Delhi).
model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  /// URL / MQTT-safe identifier, e.g. `indore-mc` (subdomain + MQTT topics).
  slug      String       @unique
  /// 3-letter prefix of pole codes and reference numbers, e.g. `IND`.
  code      String       @unique @db.VarChar(3)
  name      String
  nameHi    String
  status    TenantStatus @default(ONBOARDING)
  timezone  String       @default("Asia/Kolkata")
  /// Repair deadline for work orders, in hours.
  slaHours  Int          @default(24)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  agencies       Agency[]
  users          User[]
  zones          Zone[]
  poles          Pole[]
  devices        Device[]
  complaints     Complaint[]
  workOrders     WorkOrder[]
  counters       TenantCounter[]
  auditLogs      AuditLog[]
  schedules      Schedule[]
  deviceEvents   DeviceEvent[]
  deviceCommands DeviceCommand[]
  wards          Ward[]
  streets        Street[]
  gateways       Gateway[]

  @@map("tenants")
}

/// Per-tenant monotonic counters for human-readable numbers.
model TenantCounter {
  tenantId String @db.Uuid
  /// `pole`, `complaint`, `work_order`
  name     String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, name])
  @@map("tenant_counters")
}

// ─── People ───────────────────────────────────────────────────────────────────

enum AgencyType {
  /// The municipal corporation's own maintenance staff.
  MUNICIPAL
  /// An outsourced maintenance contractor.
  CONTRACTOR
}

/// A maintenance organisation that employs technicians.
model Agency {
  id           String     @id @default(uuid(7)) @db.Uuid
  tenantId     String     @db.Uuid
  name         String
  type         AgencyType
  contactPhone String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  users      User[]
  workOrders WorkOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("agencies")
}

enum UserRole {
  /// Platform operator (no tenant).
  SUPER_ADMIN
  /// Full control of one municipality.
  MUNICIPAL_ADMIN
  /// Assigns and verifies work orders (e.g. Junior Engineer).
  SUPERVISOR
  /// Control-room operator: monitors lights and alerts.
  OPERATOR
  /// Manages one agency's technicians and work.
  AGENCY_MANAGER
  /// Field technician using the mobile app.
  TECHNICIAN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Staff account (web consoles and mobile app). Citizens are separate (`Citizen`).
model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// Null only for SUPER_ADMIN.
  tenantId         String?    @db.Uuid
  /// Required for AGENCY_MANAGER and TECHNICIAN.
  agencyId         String?    @db.Uuid
  role             UserRole
  status           UserStatus @default(ACTIVE)
  name             String
  /// Stored lower-cased.
  email            String     @unique
  phone            String?
  passwordHash     String
  /// TOTP secret, AES-256-GCM encrypted (`v1:` envelope); null = 2FA not set up.
  /// Set but not enabled = enrolment started and not yet confirmed with a code.
  totpSecret       String?
  totpEnabled      Boolean    @default(false)
  totpEnabledAt    DateTime?  @db.Timestamptz(3)
  /// Last accepted 30-second step; a code is never accepted twice (replay protection).
  totpLastStep     Int?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?  @db.Timestamptz(3)
  lastLoginAt      DateTime?  @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)

  tenant             Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  agency             Agency?           @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  sessions           Session[]
  assignedWorkOrders WorkOrder[]       @relation("WorkOrderAssignee")
  createdWorkOrders  WorkOrder[]       @relation("WorkOrderCreator")
  workOrderEvents    WorkOrderEvent[]
  workOrderPhotos    WorkOrderPhoto[]
  mfaChallenges      MfaChallenge[]
  mfaRecoveryCodes   MfaRecoveryCode[]

  @@index([tenantId, role])
  @@index([agencyId])
  @@map("users")
}

/// Refresh-token session. Tokens rotate on every use; reuse of a rotated token
/// revokes the whole family (stolen-token detection).
/// Second sign-in step: issued after a correct password when the account uses
/// (or must set up) two-factor sign-in. Single use, short-lived, attempt-limited.
model MfaChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  /// SHA-256 of the opaque challenge token (the token itself is never stored).
  tokenHash  String    @unique
  /// `verify` (enter a code) or `setup` (enrol first, required by role)
  purpose    String
  /// `web` or `mobile`, carried over to the session it creates
  client     String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenges")
}

/// One-time recovery codes for two-factor sign-in (only their hashes are stored).
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  /// SHA-256 of the opaque refresh token (the token itself is never stored).
  tokenHash String    @unique
  familyId  String    @db.Uuid
  /// `web` or `mobile`
  client    String
  userAgent String?
  ip        String?
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  rotatedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

/// Member of the public, identified by a verified mobile number (OTP).
model Citizen {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// E.164, e.g. +919876543210
  phone       String    @unique
  name        String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  lastLoginAt DateTime? @db.Timestamptz(3)

  complaints Complaint[]

  @@map("citizens")
}

/// One-time password challenge (SMS). Only a hash of the code is stored.
model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  phone      String
  /// `citizen_login`
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

// ─── Assets ───────────────────────────────────────────────────────────────────

model Zone {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  /// Short code, e.g. `Z03`
  code      String
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  /// Lighting schedule for every controller in the zone; null = the city's default schedule.
  scheduleId String? @db.Uuid

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  poles    Pole[]
  wards    Ward[]
  streets  Street[]

  @@unique([tenantId, code])
  @@map("zones")
}

enum AssetStatus {
  ACTIVE
  DECOMMISSIONED
}

/// Operational state of the light, derived from telemetry and work orders.
enum LightStatus {
  UNKNOWN
  ON
  DIMMED
  OFF
  FAULT
  OFFLINE
}

model Pole {
  id            String      @id @default(uuid(7)) @db.Uuid
  tenantId      String      @db.Uuid
  zoneId        String?     @db.Uuid
  /// Printed on the QR plate, e.g. `IND-004182-7` (prefix, serial, check digit).
  code          String      @unique
  serial        Int
  latitude      Float
  longitude     Float
  address       String?
  /// Legacy free text (e.g. "Ward 36"). Kept as entered; `wardId` is the normalised link.
  ward          String?
  wardId        String?     @db.Uuid
  streetId      String?     @db.Uuid
  /// e.g. `LED`
  lampType      String?
  wattage       Int?
  installedAt   DateTime?   @db.Timestamptz(3)
  assetStatus   AssetStatus @default(ACTIVE)
  lightStatus   LightStatus @default(UNKNOWN)
  lightStatusAt DateTime?   @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  zone       Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  wardRef    Ward?       @relation(fields: [wardId], references: [id], onDelete: SetNull)
  street     Street?     @relation(fields: [streetId], references: [id], onDelete: SetNull)
  device     Device?
  complaints Complaint[]
  workOrders WorkOrder[]

  @@unique([tenantId, serial])
  @@index([tenantId, zoneId])
  @@index([wardId])
  @@index([streetId])
  @@index([tenantId, lightStatus])
  @@index([tenantId, latitude, longitude])
  @@map("poles")
}

/// Street light controller (ESP32-S3) installed on a pole.
model Device {
  id                String              @id @default(uuid(7)) @db.Uuid
  tenantId          String              @db.Uuid
  poleId            String?             @unique @db.Uuid
  /// MQTT client id / topic segment, e.g. `sl-000123`
  deviceId          String              @unique
  serialNumber      String?
  hardwareVersion   String?
  firmwareVersion   String?
  installStatus     DeviceInstallStatus @default(INSTALLED)
  /// True for simulator / demo controllers; never shown as physically installed hardware.
  isSimulated       Boolean             @default(false)
  online            Boolean             @default(false)
  lastSeenAt        DateTime?           @db.Timestamptz(3)
  /// Latest reported operating state (from telemetry).
  lampOn            Boolean?
  dimPercent        Int?
  /// `auto` | `manual` | `failsafe` (LightOperatingMode)
  mode              String?
  /// Most recent telemetry payload as received (validated), for the console.
  lastTelemetry     Json?
  lastTelemetryAt   DateTime?           @db.Timestamptz(3)
  resetReason       String?
  /// Schedule id the controller last acknowledged.
  appliedScheduleId String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pole       Pole?             @relation(fields: [poleId], references: [id], onDelete: SetNull)
  readings   DeviceReading[]
  events     DeviceEvent[]
  commands   DeviceCommand[]
  interfaces DeviceInterface[]
  uplinks    LorawanUplink[]

  @@index([tenantId])
  @@map("devices")
}

// ─── Complaints ───────────────────────────────────────────────────────────────

enum ComplaintCategory {
  LIGHT_OFF
  FLICKERING
  DAY_BURNING
  DAMAGED_POLE
  EXPOSED_WIRING
  OTHER
}

enum ComplaintStatus {
  SUBMITTED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintSource {
  WEB
  MOBILE
  SMS
  WHATSAPP
  CALL_CENTRE
}

model Complaint {
  id          String            @id @default(uuid(7)) @db.Uuid
  tenantId    String            @db.Uuid
  /// Shown to the citizen, e.g. `IND-C-000123`
  number      String            @unique
  poleId      String?           @db.Uuid
  citizenId   String?           @db.Uuid
  workOrderId String?           @db.Uuid
  category    ComplaintCategory
  description String?
  status      ComplaintStatus   @default(SUBMITTED)
  source      ComplaintSource
  latitude    Float?
  longitude   Float?
  photoUrl    String?
  resolvedAt  DateTime?         @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pole      Pole?      @relation(fields: [poleId], references: [id], onDelete: SetNull)
  citizen   Citizen?   @relation(fields: [citizenId], references: [id], onDelete: SetNull)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
  @@index([poleId])
  @@index([citizenId])
  @@map("complaints")
}

// ─── Work orders ──────────────────────────────────────────────────────────────

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  /// Technician marked done; waiting for IoT or supervisor verification.
  PENDING_VERIFICATION
  RESOLVED
  CANCELLED
}

enum WorkOrderSource {
  IOT_ALERT
  CITIZEN_COMPLAINT
  INSPECTION
  MANUAL
}

enum WorkOrderPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum VerificationMethod {
  /// Controller telemetry confirms the lamp draws current when switched on.
  IOT_TELEMETRY
  /// Supervisor checked the evidence (pole without a controller).
  SUPERVISOR
}

model WorkOrder {
  id                   String              @id @default(uuid(7)) @db.Uuid
  tenantId             String              @db.Uuid
  /// e.g. `IND-W-000123`
  number               String              @unique
  poleId               String              @db.Uuid
  source               WorkOrderSource
  priority             WorkOrderPriority   @default(NORMAL)
  status               WorkOrderStatus     @default(OPEN)
  /// DeviceEventType or ComplaintCategory that triggered it.
  faultType            String?
  description          String?
  assignedAgencyId     String?             @db.Uuid
  assignedTechnicianId String?             @db.Uuid
  createdById          String?             @db.Uuid
  slaDueAt             DateTime            @db.Timestamptz(3)
  startedAt            DateTime?           @db.Timestamptz(3)
  completedAt          DateTime?           @db.Timestamptz(3)
  verifiedAt           DateTime?           @db.Timestamptz(3)
  verificationMethod   VerificationMethod?
  /// e.g. `LAMP_REPLACED`, `DRIVER_REPLACED`, `WIRING_REPAIRED`
  resolutionCode       String?
  resolutionNotes      String?
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  pole       Pole             @relation(fields: [poleId], references: [id], onDelete: Restrict)
  agency     Agency?          @relation(fields: [assignedAgencyId], references: [id], onDelete: SetNull)
  technician User?            @relation("WorkOrderAssignee", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  createdBy  User?            @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  complaints Complaint[]
  events     WorkOrderEvent[]
  photos     WorkOrderPhoto[]

  @@index([tenantId, status, slaDueAt])
  @@index([assignedTechnicianId, status])
  @@index([assignedAgencyId, status])
  @@index([poleId, status])
  @@map("work_orders")
}

enum WorkOrderEventType {
  CREATED
  ASSIGNED
  STARTED
  COMPLETED
  VERIFIED
  VERIFICATION_FAILED
  REOPENED
  CANCELLED
  COMMENT
  SLA_BREACHED
}

/// Immutable timeline of everything that happened to a work order.
model WorkOrderEvent {
  id          String             @id @default(uuid(7)) @db.Uuid
  workOrderId String             @db.Uuid
  type        WorkOrderEventType
  actorUserId String?            @db.Uuid
  latitude    Float?
  longitude   Float?
  note        String?
  metadata    Json?
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workOrderId, createdAt])
  @@map("work_order_events")
}

enum PhotoKind {
  BEFORE
  AFTER
}

model WorkOrderPhoto {
  id           String    @id @default(uuid(7)) @db.Uuid
  workOrderId  String    @db.Uuid
  kind         PhotoKind
  /// Object-storage key (S3-compatible), not a public URL.
  storageKey   String
  latitude     Float?
  longitude    Float?
  takenAt      DateTime  @db.Timestamptz(3)
  uploadedById String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  workOrder  WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([workOrderId])
  @@map("work_order_photos")
}

// ─── Audit ────────────────────────────────────────────────────────────────────

enum ActorType {
  USER
  CITIZEN
  SYSTEM
  DEVICE
}

/// Append-only audit trail. UPDATE and DELETE are blocked by a database trigger.
model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String?   @db.Uuid
  actorType  ActorType
  actorId    String?
  /// e.g. `auth.login`, `work_order.assign`
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── IoT: telemetry, events, commands, schedules ─────────────────────────────

/// Telemetry history (one row per accepted telemetry message).
model DeviceReading {
  id         String   @id @default(uuid(7)) @db.Uuid
  deviceId   String   @db.Uuid
  tenantId   String   @db.Uuid
  receivedAt DateTime @default(now()) @db.Timestamptz(3)
  /// Device clock (Unix seconds); 0 when the clock was not synced.
  deviceTs   Int
  lampOn     Boolean
  dimPercent Int
  mode       String
  voltageV   Float
  currentA   Float
  powerW     Float
  energyWh   Float
  rssiDbm    Int
  /// LoRaWAN only.
  snrDb      Float?
  /// `wifi` | `cellular` | `lorawan`; null for readings before this was recorded.
  via        String?
  boardTempC Float?
  motion     Boolean  @default(false)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, receivedAt])
  @@index([tenantId, receivedAt])
  @@map("device_readings")
}

/// Faults and notable events reported by controllers.
model DeviceEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  deviceId    String    @db.Uuid
  poleId      String?   @db.Uuid
  /// DeviceEventType, e.g. `lamp_failure`
  type        String
  /// `info` | `warning` | `critical`
  severity    String
  /// For `fault_cleared`: the fault that cleared.
  clears      String?
  message     String?
  snapshot    Json?
  deviceTs    Int
  /// Per-boot message counter from the payload; with deviceTs it detects QoS 1 redeliveries.
  seq         Int       @default(0)
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  /// Work order opened because of this event, if any.
  workOrderId String?   @db.Uuid
  /// Set when the fault cleared or an operator acknowledged it.
  resolvedAt  DateTime? @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, receivedAt])
  @@index([deviceId, type, resolvedAt])
  @@map("device_events")
}

enum DeviceCommandStatus {
  /// Written by the API; the MQTT bridge has not published it yet.
  PENDING
  SENT
  ACCEPTED
  REJECTED
  COMPLETED
  FAILED
  /// Not acknowledged before `expiresAt`.
  EXPIRED
}

/// Command outbox: the API writes, the MQTT bridge publishes and records the ack.
/// `id` is the protocol `cmdId`.
model DeviceCommand {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @db.Uuid
  deviceId    String              @db.Uuid
  /// e.g. `set_output`, `set_schedule`
  action      String
  /// Full protocol payload (deviceCommandSchema), ready to publish.
  payload     Json
  status      DeviceCommandStatus @default(PENDING)
  reason      String?
  createdById String?             @db.Uuid
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  sentAt      DateTime?           @db.Timestamptz(3)
  ackAt       DateTime?           @db.Timestamptz(3)
  /// The device reported the change as applied (COMPLETED); separate from acknowledgement.
  appliedAt   DateTime?           @db.Timestamptz(3)
  /// `mqtt` (Wi-Fi / 4G) or `lorawan`
  channel     String              @default("mqtt")
  /// Network server reference for a LoRaWAN downlink (ChirpStack queue item id).
  downlinkId  String?
  expiresAt   DateTime            @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([deviceId, createdAt])
  @@map("device_commands")
}

/// Daily lighting plan sent to controllers. Steps are validated against the shared
/// schedule schema (clock time or offset from sunset/sunrise).
model Schedule {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  /// ScheduleStep[] (see @smart-light/shared)
  steps     Json
  /// The city's default schedule (poles without a zone schedule). One per tenant.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  zones  Zone[]

  @@unique([tenantId, name])
  @@map("schedules")
}

// ─── Geography (normalised) ──────────────────────────────────────────────────

/// Municipal ward. Poles keep their legacy `ward` text; `Pole.wardId` links here.
model Ward {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  zoneId    String?  @db.Uuid
  /// e.g. `36` (the municipality's own ward number)
  code      String
  name      String
  nameHi    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  zone    Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  poles   Pole[]
  streets Street[]

  @@unique([tenantId, code])
  @@index([zoneId])
  @@map("wards")
}

model Street {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  wardId    String?  @db.Uuid
  zoneId    String?  @db.Uuid
  name      String
  nameHi    String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  ward   Ward?  @relation(fields: [wardId], references: [id], onDelete: SetNull)
  zone   Zone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  poles  Pole[]

  @@index([tenantId, name])
  @@index([wardId])
  @@map("streets")
}

// ─── Devices: communication links (Wi-Fi, 4G, LoRaWAN) ───────────────────────

enum DeviceInstallStatus {
  IN_STOCK
  INSTALLED
  REMOVED
  FAULTY
}

enum CommInterfaceKind {
  WIFI
  CELLULAR
  LORAWAN
}

/// One communication link of a controller. A controller may have several
/// (e.g. 4G + LoRaWAN); none of them replaces the others.
model DeviceInterface {
  id          String            @id @default(uuid(7)) @db.Uuid
  deviceId    String            @db.Uuid
  kind        CommInterfaceKind
  /// MAC (Wi-Fi), IMEI (4G) or DevEUI (LoRaWAN), lower-case.
  identifier  String
  enabled     Boolean           @default(true)
  /// Lower = preferred for commands when several links are up.
  priority    Int               @default(100)
  lastSeenAt  DateTime?         @db.Timestamptz(3)
  lastRssiDbm Int?
  lastSnrDb   Float?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(3)

  device  Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  lorawan LorawanDevice?

  @@unique([kind, identifier])
  @@unique([deviceId, kind])
  @@map("device_interfaces")
}

/// LoRaWAN registration of a controller's radio (OTAA). The AppKey is stored
/// encrypted and is never returned by the API.
model LorawanDevice {
  id              String    @id @default(uuid(7)) @db.Uuid
  interfaceId     String    @unique @db.Uuid
  /// 16 hex characters, lower-case.
  devEui          String    @unique
  /// JoinEUI (LoRaWAN 1.0.4+ name for AppEUI), 16 hex characters.
  joinEui         String
  /// AES-GCM envelope (`v1:`); null until provisioned.
  appKeyEncrypted String?
  /// ChirpStack device-profile id or name.
  deviceProfile   String
  /// e.g. `1.0.3` (what the module firmware supports)
  macVersion      String    @default("1.0.3")
  region          String    @default("IN865")
  /// Only OTAA is used.
  activation      String    @default("OTAA")
  /// `A` or `C`
  deviceClass     String    @default("A")
  /// `NOT_JOINED` | `JOINED` (as reported by the network server, or by the simulator)
  joinStatus      String    @default("NOT_JOINED")
  joinedAt        DateTime? @db.Timestamptz(3)
  lastFCntUp      Int?
  lastUplinkAt    DateTime? @db.Timestamptz(3)
  /// Simulator device: no radio involved. Joins and uplinks are not real radio events.
  isSimulated     Boolean   @default(false)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  interface DeviceInterface @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  @@map("lorawan_devices")
}

/// A network gateway (LoRaWAN today; the record does not assume one radio or model).
model Gateway {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String?   @db.Uuid
  /// `LORAWAN`
  network      String    @default("LORAWAN")
  /// Gateway EUI / id as the network server knows it, lower-case.
  gatewayEui   String    @unique
  name         String
  manufacturer String?
  model        String?
  /// `ethernet` | `wifi` | `cellular`
  backhaul     String?
  latitude     Float?
  longitude    Float?
  altitudeM    Float?
  online       Boolean   @default(false)
  lastSeenAt   DateTime? @db.Timestamptz(3)
  isSimulated  Boolean   @default(false)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("gateways")
}

/// Every processed LoRaWAN uplink, once (idempotency by the network server's
/// deduplication id), with its radio metadata.
model LorawanUplink {
  id              String   @id @default(uuid(7)) @db.Uuid
  deduplicationId String   @unique
  devEui          String
  deviceId        String?  @db.Uuid
  fCnt            Int
  fPort           Int?
  receivedAt      DateTime @db.Timestamptz(3)
  /// Best gateway reception.
  rssiDbm         Int?
  snrDb           Float?
  gatewayEui      String?
  gatewayCount    Int      @default(0)
  dataRate        Int?
  frequencyHz     Int?
  payloadHex      String?
  /// `ok` | `decode_error` | `unknown_device`
  result          String
  isSimulated     Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([devEui, receivedAt])
  @@map("lorawan_uplinks")
}
