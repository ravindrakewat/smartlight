{
  "name": "@smart-light/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared platform-agnostic TypeScript types, enums, Zod validation schemas, and API contracts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
