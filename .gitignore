# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
out/
.next/
.expo/
web-build/
*.tsbuildinfo
next-env.d.ts

# Environment files (NEVER commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Testing & coverage
coverage/
.nyc_output/

# OS & Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Expo / Mobile native artifacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Temporary files
tmp/
temp/

# ESP-IDF firmware (generated config may contain dev credentials)
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
firmware/**/dependencies.lock
# Per-device factory provisioning files contain secrets
firmware/**/*.csv
!firmware/**/partitions.csv
firmware/**/provisioning/

# Database package: local PostgreSQL data and generated Prisma client
packages/db/.pgdata/
# Repair photos stored on disk in development (PHOTO_STORAGE=local)
apps/api/.uploads/
apps/api/.uploads-test/
packages/db/src/generated/
